# Oracle Forge 神谕台 example environment file.
# Copy this file to .env and fill in your own values.
# Do not commit .env.

ORACLE_FORGE_HOST=0.0.0.0
ORACLE_FORGE_PORT=7860

# AI provider settings
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Workspace
ORACLE_FORGE_HOME=/opt/oracle-forge
ORACLE_FORGE_WORKSPACE=/opt/oracle-forge/workspace

# AzerothCore paths
AZEROTHCORE_SOURCE_DIR=/opt/oracle-forge/workspace/source/azerothcore
AZEROTHCORE_BUILD_DIR=/opt/oracle-forge/workspace/build/azerothcore
AZEROTHCORE_INSTALL_DIR=/opt/azerothcore

# MySQL settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=

# Safety mode: stable / collaborative / autonomous
ORACLE_FORGE_MODE=stable
